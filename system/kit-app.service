[Unit]
Description=Kit Control Oberfläche (Qt, direkt auf dem Display)
After=kitd.service plymouth-quit-wait.service systemd-user-sessions.service
Wants=kitd.service
Conflicts=getty@tty1.service

[Service]
User=kit
SupplementaryGroups=video render input
RuntimeDirectory=kit-app
Environment=XDG_RUNTIME_DIR=/run/kit-app
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=KIT_ROTATION=90
EnvironmentFile=-/etc/kit/kitd.env
ExecStart=/opt/kit-controller/system/kit-app.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
