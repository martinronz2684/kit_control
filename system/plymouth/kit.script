// Schwarz, Logo mittig, darunter "by Rat3d" und ein schmaler Ladebalken.
// Das Logo ist /usr/share/plymouth/themes/kit/logo.png (weiß, transparenter Hintergrund).
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
W = Window.GetWidth(); H = Window.GetHeight();
// Hochkant-Panel? Dann ist das Bild querliegend, wir zeichnen in Landschafts-Koordinaten.
logo.image = Image("logo.png");
scale = 1; lh = 0;
if (logo.image) {
  scale = Math.Min(W * 0.5 / logo.image.GetWidth(), 1);
  logo.image = logo.image.Scale(logo.image.GetWidth() * scale, logo.image.GetHeight() * scale);
  lh = logo.image.GetHeight();
  logo.sprite = Sprite(logo.image);
  logo.sprite.SetPosition(W / 2 - logo.image.GetWidth() / 2, H / 2 - lh / 2 - 40, 1);
}
// Darunter zentriert: "by Rat3d"
brand.image = Image("by.png");
bh = 0;
if (brand.image) {
  bs = scale * 0.62;
  brand.image = brand.image.Scale(brand.image.GetWidth() * bs, brand.image.GetHeight() * bs);
  bh = brand.image.GetHeight();
  brand.sprite = Sprite(brand.image);
  brand.sprite.SetPosition(W / 2 - brand.image.GetWidth() / 2, H / 2 + lh / 2 - 40 + 18, 1);
}
track.image = Image("track.png");
fill.image = Image("fill.png");
bw = W * 0.28; bx = W / 2 - bw / 2; by = H / 2 + lh / 2 - 40 + 18 + bh + 40;
track.sprite = Sprite(track.image.Scale(bw, 4)); track.sprite.SetPosition(bx, by, 1);
fill.sprite = Sprite(); fill.sprite.SetPosition(bx, by, 2);
fun progress_cb(duration, progress) {
  w = Math.Max(1, bw * progress);
  fill.sprite.SetImage(fill.image.Scale(w, 4));
}
Plymouth.SetBootProgressFunction(progress_cb);
